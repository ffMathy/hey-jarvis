# Generated by `expo prebuild`. The native projects are derived from
# app.config.ts and modules/, so checking them in would mean maintaining two
# sources of truth for the same manifest.
/android
/ios

# Gradle's output for the local modules, written by any native build
/modules/*/android/build/
/modules/*/android/.cxx/

# Copied out of canvaskit-wasm by `turbo initialize` (.scripts/initialize.sh)
/public/canvaskit.wasm

# Expo CLI state and bundler output
.expo/
/dist

# Signing material never belongs in the repository
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Playwright output from `turbo e2e`
/playwright-report
/test-results

# Generated by .scripts/verify-hologram-on-emulator.sh
/tests/hologram-preview/recording/
/tests/hologram-preview/evidence/
