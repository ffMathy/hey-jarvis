{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "lint", "typecheck", "initialize"],
      "outputs": ["../dist/**", ".esphome/build/**"]
    },
    // Runs nothing: no package has a `transit` script. Depending on `^transit` puts a
    // workspace dependency's files into a task's hash without making it wait for
    // anything, so a change to `hologram` alone re-runs the typecheck and tests of
    // every app built on it instead of replaying their cached pass.
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["^transit"],
      "inputs": ["**/*.ts", "**/*.tsx", "tsconfig*.json"],
      "cache": true
    },
    "lint": {
      "dependsOn": ["typecheck"],
      "inputs": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.json", "$TURBO_ROOT$/biome.json"],
      "cache": true
    },
    "format": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^transit", "lint"],
      "outputs": ["../coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["lint"],
      "cache": false,
      "outputs": []
    },
    "deploy:test": {
      "cache": false
    },
    "elevenlabs#test": {
      "dependsOn": ["lint", "mcp#test"],
      "cache": false,
      "outputs": []
    },
    "elevenlabs#test:integration": {
      "dependsOn": ["lint", "mcp#test:integration"],
      "cache": false,
      "outputs": []
    },
    "deploy": {
      "dependsOn": ["build"]
    },
    "serve": {
      "cache": false,
      "persistent": true
    },
    "serve:all": {
      "cache": false,
      "persistent": true
    },
    "e2e": {
      "dependsOn": ["^transit", "build"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "build:apk": {
      "dependsOn": ["initialize"],
      "cache": false,
      "outputs": []
    },
    "build:aab": {
      "dependsOn": ["initialize"],
      "cache": false,
      "outputs": []
    },
    "mobile#e2e": {
      "dependsOn": ["^transit", "lint", "typecheck", "initialize"],
      "outputs": ["playwright-report/**", "test-results/**", "dist/**"]
    },
    "initialize": {
      "cache": true
    },
    "//#install-skia": {
      "cache": false,
      "outputs": []
    },
    "mobile#initialize": {
      "cache": false,
      "outputs": [],
      "dependsOn": ["//#install-skia"]
    },
    "watch#initialize": {
      "cache": false,
      "outputs": [],
      "dependsOn": ["//#install-skia"]
    }
  }
}
