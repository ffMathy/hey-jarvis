{
  "name": "hey-jarvis",
  "version": "1.13.1",
  "packageManager": "bun@1.3.14",
  "description": "My digital assistant that runs the house",
  "main": "index.js",
  "workspaces": [
    "mcp",
    "elevenlabs",
    "home-assistant-voice-firmware"
  ],
  "scripts": {
    "build": "turbo build",
    "serve": "turbo serve",
    "test": "turbo test",
    "deploy": "turbo deploy",
    "lint": "turbo lint",
    "format": "bunx biome format --write .",
    "check": "bunx biome check --write .",
    "audit": "bun audit --audit-level=high",
    "check:supply-chain": "bash ./.scripts/check-supply-chain.sh",
    "prepare": "git config core.hooksPath .husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ffMathy/hey-jarvis.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ffMathy/hey-jarvis/issues"
  },
  "homepage": "https://github.com/ffMathy/hey-jarvis#readme",
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.3.14",
    "@types/express": "5.0.6",
    "@types/node": "26.1.2",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "execa": "10.0.1",
    "lint-staged": "17.3.0",
    "mastra": "1.24.0",
    "prettier": "3.9.6",
    "tslib": "2.8.1",
    "tsx": "4.23.11",
    "turbo": "2.10.9",
    "typescript": "6.0.3",
    "wait-port": "1.1.0",
    "ws": "8.21.3"
  },
  "//typescript": "Held at 6.x deliberately — do NOT bump to 7. TypeScript 7 is the native port and drops the legacy JS compiler API (ts.sys, ts.readConfigFile and ts.resolveModuleName are all undefined). typescript-paths, which @mastra/deployer depends on, peers on '^4.7.2 || ^5 || ^6' and calls ts.sys, so `mastra dev` dies at startup with \"undefined is not an object (evaluating 'host.readFile')\" — taking Studio on 4111 with it, and failing the container healthcheck. Typechecking does not go through this package; it uses tsgo from @typescript/native-preview.",
  "engines": {
    "bun": ">=1.3.14"
  },
  "//overrides": "Transitive dependencies pinned forward to patched versions because their parents still request a vulnerable range. Every entry is a security fix — verify with `bun run audit` before removing one. Bun only honors flat overrides; the npm nested form is silently ignored.",
  "overrides": {
    "@grpc/grpc-js": "1.14.4",
    "@hono/node-server": "2.0.12",
    "@opentelemetry/core": "2.10.0",
    "@protobufjs/utf8": "1.1.1",
    "axios": "1.18.0",
    "body-parser": "2.3.0",
    "express-rate-limit": "8.2.2",
    "fast-uri": "3.1.5",
    "follow-redirects": "1.16.0",
    "form-data": "4.0.6",
    "hono": "4.13.1",
    "ip-address": "10.3.1",
    "picomatch": "4.0.5",
    "protobufjs": "7.6.5",
    "qs": "6.15.2",
    "shell-quote": "1.9.0",
    "uuid": "11.1.1",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": [
      "bunx biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@ai-sdk/google": "3.0.43",
    "@ai-sdk/openai": "3.0.41",
    "@ai-sdk/provider": "3.0.8",
    "@ai-sdk/provider-utils": "4.0.19",
    "@anthropic-ai/sdk": "0.116.0",
    "@azure/msal-node": "5.5.0",
    "@elevenlabs/elevenlabs-js": "2.64.0",
    "@googlemaps/google-maps-services-js": "3.4.2",
    "@hono/node-server": "2.0.12",
    "@libsql/client": "0.17.4",
    "@mastra/core": "1.58.0",
    "@mastra/evals": "1.7.0",
    "@mastra/hono": "1.6.0",
    "@mastra/libsql": "1.20.0",
    "@mastra/loggers": "1.2.0",
    "@mastra/mcp": "1.16.0",
    "@mastra/memory": "1.26.1",
    "@mastra/observability": "1.16.6",
    "@mastra/server": "1.58.0",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@types/lodash-es": "4.17.12",
    "@types/node-cron": "3.0.11",
    "@types/node-fetch": "2.6.13",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@yarflam/potion-base-8m": "1.0.4",
    "ai": "6.0.116",
    "ai-sdk-ollama": "3.8.0",
    "commander": "15.0.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "fkill": "10.0.3",
    "geolib": "3.3.14",
    "googleapis": "174.0.1",
    "hono": "4.13.1",
    "lodash-es": "4.18.1",
    "node-cron": "4.6.0",
    "octokit": "5.0.5",
    "open": "11.0.0",
    "twilio": "6.0.2",
    "zod": "4.4.3"
  }
}
