{
  "mcpServers": {
    "mastra": {
      "command": "bunx",
      "args": ["@mastra/mcp-docs-server@1.2.14"],
      "type": "stdio",
      "tools": ["*"]
    },
    "github-mcp-server": {
      "tools": ["*"],
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "playwright": {
      "type": "stdio",
      "tools": ["*"],
      "command": "bunx",
      "args": ["@playwright/mcp@0.0.79", "--browser", "chromium", "--no-sandbox"]
    }
  }
}
