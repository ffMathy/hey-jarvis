<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    The service that hears the phone when this app is not running.

    A Gradle library manifest, merged into the app's own at build time — the same arrangement as
    `mobile/modules/jarvis-assistant`, and for the same reason: `android/` is regenerated by
    `expo prebuild`, so a declaration written there would not survive, and one written in a config
    plugin would sit a long way from the Kotlin it describes.
  -->
  <application>

    <!--
      Play Services starts this when a Data Layer message arrives, so the phone's "send the key to
      your watch" button works without anybody opening Jarvis on the watch first.

      Three things here are load-bearing:

      - `exported="true"`, because it is Play Services — a different UID — that binds it. Exported
        does not mean open: the Data Layer only delivers between two apps that share a package
        name and a signing key, and the `BIND_LISTENER` permission below is Google's own.
      - the exact `MESSAGE_RECEIVED` action, which is how Play Services finds it at all.
      - the `<data>` path, which narrows delivery to the one path this app answers on. Without it
        the service is woken for every message any part of the Data Layer carries.
    -->
    <service
      android:name="expo.modules.jarvisphone.JarvisPhoneListenerService"
      android:exported="true"
      android:permission="com.google.android.gms.permission.BIND_LISTENER">
      <intent-filter>
        <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
        <data android:scheme="wear" android:host="*" android:pathPrefix="/jarvis/elevenlabs-settings" />
      </intent-filter>
    </service>

  </application>

</manifest>
