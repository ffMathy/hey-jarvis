{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "..",
    // Nothing should ever emit from this project, but `rootDir` is the workspace
    // root and the `include` below reaches into `mcp`, so anything that does emit
    // without an `outDir` scatters .js and .js.map files beside the sources of two
    // packages at once. A `tsgo --build` of the workspace root does exactly that,
    // and leaves 130 untracked files behind for the next `biome check --write` to
    // reformat. Naming an output directory makes that outcome harmless — and it is
    // the one `.scripts/test.sh` already deletes before each run.
    "outDir": "../dist/elevenlabs-spec",
    "types": ["bun-types", "node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // Nothing is emitted for this project — `bun` runs the TypeScript directly and
    // .scripts/build.sh produces no output — so `composite` would only oblige us to
    // list every file the tests reach into over in `mcp`, for declarations nobody
    // reads. Turning it off lets the cross-project imports resolve as sources.
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false
  },
  // The tests import mcp sources directly, so they need mcp's ambient module
  // declarations along with them — without those, every untyped dependency mcp
  // declares for itself reappears here as an implicit any.
  "include": ["src/**/*.ts", "src/**/*.json", "tests/**/*.ts", "../mcp/mastra/types/**/*.d.ts"],
  "exclude": ["**/node_modules", "**/.*/", "**/dist", "**/build"]
}
