# References the server can run without. `.scripts/run-with-env.sh` passes on only the ones that
# resolve, so a missing item switches off the feature that needs it instead of the whole server —
# `op run` fails on the first reference it cannot resolve, which is why these are not in op.env.
#
# Claude Code sessions (coding vertical), run in a Docker Sandbox on the host over SSH, on the
# Claude subscription — create the "Claude Code" SSH Key item in the Jarvis vault (see mcp/README.md).
# Without it, only coding sessions are unavailable.
HEY_JARVIS_CLAUDE_CODE_SSH_TARGET="op://Jarvis/Claude Code/SSH target"
HEY_JARVIS_CLAUDE_CODE_SSH_PRIVATE_KEY="op://Jarvis/Claude Code/private key?ssh-format=openssh"
HEY_JARVIS_CLAUDE_CODE_OAUTH_TOKEN="op://Jarvis/Claude Code/OAuth token"

# Primary user phone number (E.164), used by sendNotification to call him
HEY_JARVIS_PRIMARY_USER_PHONE_NUMBER="op://Jarvis/Primary user/Phone number"

# Public address of the MCP server, where the visualize vertical hosts its pages for a day
HEY_JARVIS_CLOUDFLARED_TUNNEL_URL="op://Jarvis/Jarvis/Cloudflared URL"
