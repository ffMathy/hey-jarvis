{
  "name": "hologram",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsgo --noEmit --project tsconfig.json",
    "lint": "cd .. && bunx biome check --write hologram",
    "format": "cd .. && bunx biome format --write hologram",
    "test": "cd .. && bash hologram/.scripts/test.sh"
  },
  "//peer": "Only types are imported from Skia — nothing here calls into it — so whichever app draws the hologram brings its own copy. Both of them already depend on it directly.",
  "peerDependencies": {
    "@shopify/react-native-skia": "*"
  },
  "devDependencies": {
    "@shopify/react-native-skia": "2.6.2",
    "bun-types": "1.3.14"
  }
}
