{
  "name": "wear",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "typecheck": "tsgo --noEmit --project tsconfig.json",
    "lint": "cd .. && bunx biome check --write wear",
    "format": "cd .. && bunx biome format --write wear",
    "build:apk": "cd .. && bash wear/.scripts/build-apk.sh",
    "start": "bunx expo start",
    "android": "bunx expo run:android",
    "native:prebuild": "bunx expo prebuild --platform android"
  },
  "dependencies": {
    "@shopify/react-native-skia": "2.6.2",
    "expo": "57.0.20",
    "expo-status-bar": "57.0.1",
    "hologram": "workspace:*",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@expo/config-plugins": "57.0.9",
    "@types/react": "19.2.18",
    "babel-preset-expo": "57.0.10",
    "bun-types": "1.3.14"
  }
}
