{
  "name": "vr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "initialize": "bash .scripts/initialize.sh",
    "typecheck": "tsgo --noEmit --project tsconfig.json",
    "lint": "cd .. && bunx biome check --write vr",
    "format": "cd .. && bunx biome format --write vr",
    "build": "cd .. && bash vr/.scripts/build.sh",
    "test": "cd .. && bash vr/.scripts/test.sh",
    "e2e": "bunx playwright test --config playwright.config.ts",
    "serve": "bunx vite --host"
  },
  "dependencies": {
    "@elevenlabs/client": "1.24.0",
    "@shopify/react-native-skia": "2.6.2",
    "canvaskit-wasm": "0.41.0",
    "hologram": "workspace:*",
    "livekit-client": "2.22.2",
    "onnxruntime-web": "1.30.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@iwer/sem": "2.4.0",
    "@types/three": "0.186.0",
    "@types/webxr": "0.5.24",
    "bun-types": "1.3.14",
    "iwer": "2.4.0",
    "vite": "8.3.0"
  }
}
