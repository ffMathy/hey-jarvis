# Bun is the only supported package manager in this repository (see
# AGENTS.md → Supply Chain Security). These settings exist purely as defense in
# depth: if npm is ever invoked by accident or by a third-party tool, it must
# behave at least as safely as Bun does.

# Never write version ranges.
save-exact=true

# Never execute dependency lifecycle scripts.
ignore-scripts=true

# Pin the registry so it cannot be redirected silently.
registry=https://registry.npmjs.org/

# Refuse to install when the engine requirements in package.json are not met.
engine-strict=true

# Never write an npm lockfile — bun.lock is the single source of truth.
package-lock=false
